# --- API (apps/api) ---
PORT=3000
# PostgreSQL (obligatoire). Local : docker compose up -d db
DATABASE_URL=postgres://sge:sge@localhost:5432/sge
# Migrations appliquées au démarrage (false = les jouer à part avec `npm run db:migrate`)
RUN_MIGRATIONS=true
# Comptes de démonstration dans une base vide (jamais par défaut en production)
SEED_DEMO=true
# Premier administrateur créé au démarrage s'il n'en existe aucun (déploiement sans démo). Retirer ensuite le mot de passe.
# BOOTSTRAP_ADMIN_NAME=Administrateur
# BOOTSTRAP_ADMIN_PHONE=
# BOOTSTRAP_ADMIN_PASSWORD=
# Adresse du site web, citée dans les SMS d'invitation
WEB_URL=http://localhost:5173
# Obligatoire en production (jetons de session). Générer : openssl rand -hex 32
JWT_SECRET=
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGIN=http://localhost:5173

# --- Web (apps/web) ---
API_URL=http://localhost:3000/api
# Obligatoire en production (cookie de session signé)
SESSION_SECRET=
# true = affiche les profils de démonstration sur la page de connexion
DEMO_LOGIN=false

# --- Mobile (apps/mobile) ---
# Émulateur Android : http://10.0.2.2:3000/api ; appareil réel : IP de votre machine
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_DEMO=true
